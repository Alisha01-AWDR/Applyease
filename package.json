{
  "name": "applyease",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test journey",
    "test:a11y": "playwright test a11y",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:backend": "python -m pytest backend/tests -q",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:backend && npm run test:e2e && npm run test:a11y"
  },
  "dependencies": {
    "lucide-react": "0.545.0",
    "motion": "12.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.0",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "three": "0.180.0",
    "lottie-react": "2.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.0",
    "@types/node": "22.12.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.0",
    "prettier": "3.6.0",
    "tsx": "4.20.0",
    "typescript": "5.9.3",
    "vite": "7.1.0"
  }
}
