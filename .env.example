# Frontend build/runtime API URL
VITE_API_URL=http://localhost:8000

# Optional server-side AI key used by docker compose
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5

# Use a strong random value outside local development
JWT_SECRET=replace-with-a-long-random-secret
APP_ENV=development

# Comma-separated employer hosts allowed for URL-based job import
APPROVED_JOB_HOSTS=
# Production: set strong unique values. Never use the development defaults.
# APP_ENV=production
# JWT_SECRET=replace-with-at-least-32-random-characters
# DISCLOSURE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY=replace-with-a-fernet-key
# FILE_STORAGE_DIR=/var/lib/applyease/files
# FILE_ENCRYPTION_KEY=replace-with-a-fernet-key
